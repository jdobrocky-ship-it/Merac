/* =========================================================
   JSZIP
========================================================= */

/*
 * JSZip načítame dynamicky.
 *
 * Tým zostáva hlavný CLIP import
 * oddelený od ZIP knižnice.
 */

let JSZip;


async function loadJSZip() {

    if (
        JSZip
    ) {
        return JSZip;
    }


    const module =
        await import(
            "https://cdn.jsdelivr.net/npm/jszip@3.10.1/+esm"
        );


    JSZip =
        module.default;


    return JSZip;
}


/* =========================================================
   IMPORT – ZÁKLADNÁ VALIDÁCIA
========================================================= */

function assert(
    condition,
    message
) {

    if (!condition) {

        throw new Error(
            message
        );
    }
}


function validateUniqueIds(
    records,
    field,
    label
) {

    const ids =
        new Set();


    for (
        const record
        of records
    ) {

        const value =
            record[field];


        assert(
            typeof value ===
                "string" &&
            value.length > 0,
            `${label}: chýba ID.`
        );


        assert(
            !ids.has(value),
            `${label}: duplicitné ID ${value}.`
        );


        ids.add(
            value
        );
    }
}


function validateVector(
    vector,
    label
) {

    assert(
        Array.isArray(vector),
        `${label}: embedding nie je pole.`
    );


    assert(
        vector.length ===
            EMBEDDING_SIZE,
        `${label}: nesprávna veľkosť embeddingu.`
    );


    for (
        const value
        of vector
    ) {

        assert(
            typeof value ===
                "number" &&
            Number.isFinite(
                value
            ),
            `${label}: neplatná hodnota.`
        );
    }
}


/* =========================================================
   VALIDÁCIA BACKUPU
========================================================= */

async function validateBackup(
    zip
) {

    const manifestFile =
        zip.file(
            "manifest.json"
        );


    assert(
        manifestFile,
        "V ZIP chýba manifest.json."
    );


    const manifest =
        JSON.parse(
            await manifestFile.async(
                "string"
            )
        );


    assert(
        manifest.backupFormat ===
            BACKUP_FORMAT,
        "Tento ZIP má starší alebo nepodporovaný formát."
    );


    assert(
        manifest.embeddingModel ===
            EMBEDDING_MODEL,
        "Záloha používa iný CLIP model."
    );


    assert(
        manifest.embeddingSize ===
            EMBEDDING_SIZE,
        "Záloha má inú veľkosť embeddingov."
    );


    const files = {

        meterTypes:
            zip.file(
                "meterTypes.json"
            ),

        photos:
            zip.file(
                "photos.json"
            ),

        embeddings:
            zip.file(
                "embeddings.json"
            ),

        prototypes:
            zip.file(
                "prototypes.json"
            )
    };


    for (
        const [
            name,
            file
        ]
        of Object.entries(
            files
        )
    ) {

        assert(
            file,
            `V ZIP chýba ${name}.json.`
        );
    }


    const types =
        JSON.parse(
            await files.meterTypes.async(
                "string"
            )
        );


    const photoManifest =
        JSON.parse(
            await files.photos.async(
                "string"
            )
        );


    const embeddings =
        JSON.parse(
            await files.embeddings.async(
                "string"
            )
        );


    const prototypes =
        JSON.parse(
            await files.prototypes.async(
                "string"
            )
        );


    assert(
        Array.isArray(types),
        "meterTypes.json nie je pole."
    );


    assert(
        Array.isArray(photoManifest),
        "photos.json nie je pole."
    );


    assert(
        Array.isArray(embeddings),
        "embeddings.json nie je pole."
    );


    assert(
        Array.isArray(prototypes),
        "prototypes.json nie je pole."
    );


    assert(
        manifest.counts.meterTypes ===
            types.length,
        "Nesedí počet typov."
    );


    assert(
        manifest.counts.photos ===
            photoManifest.length,
        "Nesedí počet fotografií."
    );


    assert(
        manifest.counts.embeddings ===
            embeddings.length,
        "Nesedí počet embeddingov."
    );


    assert(
        manifest.counts.prototypes ===
            prototypes.length,
        "Nesedí počet prototypov."
    );


    validateUniqueIds(
        types,
        "id",
        "Typy"
    );


    validateUniqueIds(
        photoManifest,
        "id",
        "Fotografie"
    );


    validateUniqueIds(
        embeddings,
        "id",
        "Embeddingy"
    );


    const typeIds =
        new Set(
            types.map(
                type =>
                    type.id
            )
        );


    const photoIds =
        new Set(
            photoManifest.map(
                photo =>
                    photo.id
            )
        );


    const photoTypeMap =
        new Map();


    for (
        const photo
        of photoManifest
    ) {

        assert(
            typeIds.has(
                photo.meterTypeId
            ),
            `Fotografia ${photo.id} má neexistujúci typ.`
        );


        assert(
            zip.file(
                photo.path
            ),
            `V ZIP chýba ${photo.path}.`
        );


        photoTypeMap.set(
            photo.id,
            photo.meterTypeId
        );
    }


    const embeddingPhotos =
        new Set();


    const countByType =
        new Map();


    for (
        const embedding
        of embeddings
    ) {

        assert(
            photoIds.has(
                embedding.photoId
            ),
            `Embedding ${embedding.id} má neexistujúcu fotografiu.`
        );


        assert(
            typeIds.has(
                embedding.meterTypeId
            ),
            `Embedding ${embedding.id} má neexistujúci typ.`
        );


        assert(
            photoTypeMap.get(
                embedding.photoId
            ) ===
                embedding.meterTypeId,
            `Embedding ${embedding.id} nemá rovnaký typ ako fotografia.`
        );


        assert(
            !embeddingPhotos.has(
                embedding.photoId
            ),
            `Fotografia ${embedding.photoId} má viac embeddingov.`
        );


        embeddingPhotos.add(
            embedding.photoId
        );


        validateVector(
            embedding.vector,
            `Embedding ${embedding.id}`
        );


        countByType.set(
            embedding.meterTypeId,
            (
                countByType.get(
                    embedding.meterTypeId
                ) || 0
            ) + 1
        );
    }


    assert(
        embeddingPhotos.size ===
            photoIds.size,
        "Niektorá fotografia nemá embedding."
    );


    const prototypeTypes =
        new Set();


    for (
        const prototype
        of prototypes
    ) {

        assert(
            typeIds.has(
                prototype.meterTypeId
            ),
            "Prototyp má neexistujúci typ."
        );


        assert(
            !prototypeTypes.has(
                prototype.meterTypeId
            ),
            "Typ má viac prototypov."
        );


        prototypeTypes.add(
            prototype.meterTypeId
        );


        validateVector(
            prototype.vector,
            `Prototyp ${prototype.meterTypeId}`
        );


        const expected =
            countByType.get(
                prototype.meterTypeId
            ) || 0;


        assert(
            prototype.count ===
                expected,
            `Prototyp ${prototype.meterTypeId} má nesprávny počet vzoriek.`
        );
    }


    return {

        manifest,

        types,

        photoManifest,

        embeddings,

        prototypes
    };
}


/* =========================================================
   IMPORT
========================================================= */

async function importBackup(
    file
) {

    if (!file) {
        return;
    }


    try {

        setStatus(
            "Načítavam ZIP..."
        );


        const Zip =
            await loadJSZip();


        const zip =
            await Zip.loadAsync(
                file
            );


        setStatus(
            "Kontrolujem ZIP..."
        );


        /*
         * Kompletná kontrola ešte
         * pred vymazaním DB.
         */
        const backup =
            await validateBackup(
                zip
            );


        if (
            !confirm(
                "Záloha je platná.\n\n" +
                "Import nahradí aktuálnu databázu.\n\n" +
                "Pokračovať?"
            )
        ) {

            setStatus(
                "Import zrušený."
            );

            return;
        }


        /*
         * Najprv načítame všetky fotografie.
         */
        const photoBlobs =
            [];


        for (
            const photo
            of backup.photoManifest
        ) {

            const zipFile =
                zip.file(
                    photo.path
                );


            if (!zipFile) {

                throw new Error(
                    `Chýba ${photo.path}`
                );
            }


            const blob =
                await zipFile.async(
                    "blob"
                );


            photoBlobs.push({

                photo,

                blob
            });
        }


        setStatus(
            "Vymazávam starú databázu..."
        );


        await clearDatabase(
            false,
            false
        );


        /*
         * Typy.
         */
        for (
            const type
            of backup.types
        ) {

            await put(
                "meterTypes",
                type
            );
        }


        /*
         * Fotografie.
         */
        for (
            const item
            of photoBlobs
        ) {

            await put(
                "photos",
                {

                    id:
                        item.photo.id,

                    meterTypeId:
                        item.photo.meterTypeId,

                    blob:
                        item.blob,

                    fileName:
                        item.photo.fileName,

                    created:
                        item.photo.created
                }
            );
        }


        /*
         * Embeddingy.
         */
        for (
            const embedding
            of backup.embeddings
        ) {

            await put(
                "embeddings",
                embedding
            );
        }


        /*
         * Prototypy.
         */
        for (
            const prototype
            of backup.prototypes
        ) {

            await put(
                "prototypes",
                prototype
            );
        }


        await refreshUI();


        setStatus(
            "✓ Import CLIP zálohy bol úspešný."
        );


    } catch (error) {

        console.error(
            error
        );


        setStatus(
            "Import zlyhal: " +
            error.message,
            true
        );


    } finally {

        const input =
            document.getElementById(
                "importFile"
            );


        if (input) {
            input.value = "";
        }
    }
}


