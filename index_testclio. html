        return;
    }


    const list =
        document.createElement(
            "div"
        );


    list.className =
        "photo-list";


    for (
        const photo
        of photos
    ) {

        const key =
            `${meterTypeId}:${photo.id}`;


        const url =
            URL.createObjectURL(
                photo.blob
            );


        photoObjectURLs.set(
            key,
            url
        );


        const item =
            document.createElement(
                "div"
            );


        item.className =
            "photo-item";


        item.innerHTML = `

            <img
                src="${url}"
                alt=""
            >

