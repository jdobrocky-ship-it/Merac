/* =========================================================
   CLEAR DATABASE
========================================================= */

async function clearDatabase(
    ask = true,
    refresh = true
) {

    if (
        ask &&
        !confirm(
            "Naozaj chceš vymazať CELÚ databázu?"
        )
    ) {

        return;
    }


    const stores = [

        "meterTypes",
        "photos",
        "embeddings",
        "prototypes",
        "settings"

    ];


    await new Promise(
        (resolve, reject) => {

            const tx =
                db.transaction(
                    stores,
                    "readwrite"
                );


            for (
                const store
                of stores
            ) {

                tx.objectStore(
                    store
                ).clear();
            }


            tx.oncomplete =
                resolve;


            tx.onerror =
                () =>
                    reject(
                        tx.error
                    );


            tx.onabort =
                () =>
                    reject(
                        tx.error ||
                        new Error(
                            "Vymazanie databázy zlyhalo."
                        )
                    );
        }
    );


    openPhotoIds.clear();


    for (
        const url
        of photoObjectURLs.values()
    ) {

        URL.revokeObjectURL(
            url
        );
    }


    photoObjectURLs.clear();


    setStatus(
        "Databáza bola vymazaná."
    );


    if (
        refresh
    ) {

        await refreshUI();
    }
}


/* =========================================================
   FILE EXTENSION
========================================================= */

function getFileExtension(
    fileName
) {

    if (
        !fileName
    ) {
        return "jpg";
    }


    const parts =
        fileName.split(".");


    if (
        parts.length < 2
    ) {
        return "jpg";
    }


    const ext =
        parts
            .pop()
            .toLowerCase()
            .replace(
                /[^a-z0-9]/g,
                ""
            );


    return ext || "jpg";
}


