        setStatus(
            "Databáza je pripravená. CLIP sa načíta pri prvej fotografii."
        );


        await refreshUI();


    } catch (error) {

        console.error(
            error
        );


        setStatus(
            "Inicializácia zlyhala: " +
            error.message,
            true
        );
    }
}


