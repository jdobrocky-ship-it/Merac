<script type="module">

/*
 * =========================================================
 * TRANSFORMERS.JS
 * =========================================================
 *
 * Používame stabilnú verziu 3.8.1.
 *
 * Model:
 * Xenova/clip-vit-base-patch32
 *
 * Výstup:
 * 512-rozmerný obrazový embedding.
 */

import {
    pipeline
} from "https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.8.1";


/* =========================================================
   KONFIGURÁCIA
========================================================= */

const DB_NAME =
    "MeraceTestDB";

const DB_VERSION =
    1;


/*
 * Formát ZIP zálohy je oddelený
 * od verzie IndexedDB.
 */
const BACKUP_FORMAT =
    2;


/*
 * Aktuálny CLIP model.
 */
const EMBEDDING_MODEL =
    "Xenova/clip-vit-base-patch32";


/*
 * CLIP ViT-B/32 má obrazové embeddingy
 * veľkosti 512.
 */
const EMBEDDING_SIZE =
    512;


let db = null;


/*
 * CLIP pipeline sa vytvorí iba raz.
 */
let clipExtractor =
    null;


/*
 * true počas načítavania modelu.
 */
let clipLoading =
    false;


/*
 * Zoznamy otvorených fotografií.
 */
const openPhotoIds =
    new Set();


/*
 * Blob URL fotografie.
 */
const photoObjectURLs =
    new Map();


/* =========================================================
   STATUS
========================================================= */

function setStatus(
    text,
    error = false
) {

    const el =
        document.getElementById(
            "status"
        );

    el.textContent =
        text;

    el.className =
        error
            ? "status danger"
            : "status";
}


function setClipProgress(
    text
) {

    document.getElementById(
        "clipProgress"
    ).textContent =
        text;
}


/* =========================================================
   ID
========================================================= */

function id() {

    return crypto.randomUUID();
}


/* =========================================================
   HTML ESCAPE
========================================================= */

function escapeHTML(
    value
) {

    if (
        value === null ||
        value === undefined
    ) {
        return "";
    }

    return String(value)
        .replace(
            /&/g,
            "&amp;"
        )
        .replace(
            /</g,
            "&lt;"
        )
        .replace(
            />/g,
            "&gt;"
        )
        .replace(
            /"/g,
            "&quot;"
        )
        .replace(
            /'/g,
            "&#039;"
        );
}


/* =========================================================
   VEKTOR
========================================================= */

function normalize(
    vector
) {

    let sum = 0;

    for (
        const value of vector
    ) {

        sum +=
            value * value;
    }

    const length =
        Math.sqrt(sum);


    if (!length) {

        return vector.map(
            () => 0
        );
    }


    return vector.map(
        value =>
            value / length
    );
}


function averageVectors(
    vectors
) {

    if (
        !vectors.length
    ) {
        return null;
    }


    const result =
        new Array(
            vectors[0].length
        ).fill(0);


    for (
        const vector
        of vectors
    ) {

        for (
            let i = 0;
            i < vector.length;
            i++
        ) {

            result[i] +=
                vector[i];
        }
    }


    for (
        let i = 0;
        i < result.length;
        i++
    ) {

        result[i] /=
            vectors.length;
    }


    /*
     * Dôležité:
     * pri CLIP prototyp znova
     * normalizujeme.
     */
    return normalize(
        result
    );
}


/* =========================================================
   CLIP – NAČÍTANIE MODELU
========================================================= */

async function loadCLIP() {

    if (
        clipExtractor
    ) {

        return clipExtractor;
    }


    if (
        clipLoading
    ) {

        while (
            clipLoading
        ) {

            await new Promise(
                resolve =>
                    setTimeout(
                        resolve,
                        100
                    )
            );
        }

        return clipExtractor;
    }


    clipLoading =
        true;


    try {

        setStatus(
            "CLIP: načítavam model..."
        );


        setClipProgress(
            "Prvé načítanie môže trvať dlhšie. Model sa potom cachuje."
        );


        clipExtractor =
            await pipeline(
                "image-feature-extraction",
                EMBEDDING_MODEL,
                {
                    progress_callback:
                        progress => {

                            /*
                             * Nie všetky typy
                             * progress správ majú
                             * rovnakú štruktúru.
                             */

                            if (
                                progress &&
                                typeof progress.progress ===
                                "number"
                            ) {

                                setClipProgress(
                                    `CLIP: ${Math.round(progress.progress)} %`
                                );
                            }
                        }
                }
            );


        setStatus(
            "✓ CLIP je pripravený."
        );


        setClipProgress(
            `Model: ${EMBEDDING_MODEL}`
        );


        return clipExtractor;


    } catch (error) {

        console.error(
            "CLIP loading error:",
            error
        );


        clipExtractor =
            null;


        setStatus(
            "CLIP sa nepodarilo načítať: " +
            error.message,
            true
        );


        setClipProgress(
            ""
        );


        throw error;


    } finally {

        clipLoading =
            false;
    }
}


/* =========================================================
   CLIP – EMBEDDING FOTOGRAFIE
========================================================= */

async function createCLIPEmbedding(
    blob
) {

    const extractor =
        await loadCLIP();


    /*
     * Blob prevedieme na dočasnú URL.
     */
    const url =
        URL.createObjectURL(
            blob
        );


    try {

        setClipProgress(
            "CLIP: analyzujem fotografiu..."
        );


        const output =
            await extractor(
                url
            );


        /*
         * Transformers.js vracia Tensor.
         *
         * Pri CLIP:
         * [1, 512]
         */
        let vector =
            Array.from(
                output.data
            );


        /*
         * Kontrola rozmeru.
         */
        if (
            vector.length !==
            EMBEDDING_SIZE
        ) {

            throw new Error(
                `CLIP vrátil ${vector.length} hodnôt namiesto ${EMBEDDING_SIZE}.`
            );
        }


        /*
         * Finálna L2 normalizácia.
         */
        vector =
            normalize(
                vector
            );


        setClipProgress(
            `CLIP: hotovo (${vector.length} hodnôt)`
        );


        return vector;


    } finally {

        URL.revokeObjectURL(
            url
        );
    }
}


/* =========================================================
   INDEXEDDB
========================================================= */

function openDatabase() {

    return new Promise(
        (resolve, reject) => {

            const request =
                indexedDB.open(
                    DB_NAME,
                    DB_VERSION
                );


            request.onupgradeneeded =
                event => {

                    const database =
                        event.target.result;


                    if (
                        !database.objectStoreNames.contains(
                            "meterTypes"
                        )
                    ) {

                        database.createObjectStore(
                            "meterTypes",
                            {
                                keyPath:
                                    "id"
                            }
                        );
                    }


                    if (
                        !database.objectStoreNames.contains(
                            "photos"
                        )
                    ) {

                        const store =
                            database.createObjectStore(
                                "photos",
                                {
                                    keyPath:
                                        "id"
                                }
                            );


                        store.createIndex(
                            "meterTypeId",
                            "meterTypeId",
                            {
                                unique:
                                    false
                            }
                        );
                    }


                    if (
                        !database.objectStoreNames.contains(
                            "embeddings"
                        )
                    ) {

                        const store =
                            database.createObjectStore(
                                "embeddings",
                                {
                                    keyPath:
                                        "id"
                                }
                            );


                        store.createIndex(
                            "photoId",
                            "photoId",
                            {
                                unique:
                                    true
                            }
                        );


                        store.createIndex(
                            "meterTypeId",
                            "meterTypeId",
                            {
                                unique:
                                    false
                            }
                        );
                    }


                    if (
                        !database.objectStoreNames.contains(
                            "prototypes"
                        )
                    ) {

                        database.createObjectStore(
                            "prototypes",
                            {
                                keyPath:
                                    "meterTypeId"
                            }
                        );
                    }


                    if (
                        !database.objectStoreNames.contains(
                            "settings"
                        )
                    ) {

                        database.createObjectStore(
                            "settings",
                            {
                                keyPath:
                                    "id"
                            }
                        );
                    }
                };


            request.onsuccess =
                event => {

                    db =
                        event.target.result;


                    db.onversionchange =
                        () => {
                            db.close();
                        };


                    resolve(
                        db
                    );
                };


            request.onerror =
                () => {

                    reject(
                        request.error
                    );
                };
        }
    );
}


/* =========================================================
   DB HELPERS
========================================================= */

function getAll(
    storeName
) {

    return new Promise(
        (resolve, reject) => {

            const tx =
                db.transaction(
                    storeName,
                    "readonly"
                );


            const request =
                tx.objectStore(
                    storeName
                ).getAll();


            request.onsuccess =
                () =>
                    resolve(
                        request.result
                    );


            request.onerror =
                () =>
                    reject(
                        request.error
                    );
        }
    );
}


function getById(
    storeName,
    key
) {

    return new Promise(
        (resolve, reject) => {

            const tx =
                db.transaction(
                    storeName,
                    "readonly"
                );


            const request =
                tx.objectStore(
                    storeName
                ).get(key);


            request.onsuccess =
                () =>
                    resolve(
                        request.result
                    );


            request.onerror =
                () =>
                    reject(
                        request.error
                    );
        }
    );
}


function getByIndex(
    storeName,
    indexName,
    value
) {

    return new Promise(
        (resolve, reject) => {

            const tx =
                db.transaction(
                    storeName,
                    "readonly"
                );


            const request =
                tx.objectStore(
                    storeName
                )
                .index(indexName)
                .get(value);


            request.onsuccess =
                () =>
                    resolve(
                        request.result
                    );


            request.onerror =
                () =>
                    reject(
                        request.error
                    );
        }
    );
}


function getAllByIndex(
    storeName,
    indexName,
    value
) {

    return new Promise(
        (resolve, reject) => {

            const tx =
                db.transaction(
                    storeName,
                    "readonly"
                );


            const request =
                tx.objectStore(
                    storeName
                )
                .index(indexName)
                .getAll(value);


            request.onsuccess =
                () =>
                    resolve(
                        request.result
                    );


            request.onerror =
                () =>
                    reject(
                        request.error
                    );
        }
    );
}


function put(
    storeName,
    data
) {

    return new Promise(
        (resolve, reject) => {

            const tx =
                db.transaction(
                    storeName,
                    "readwrite"
                );


            tx.objectStore(
                storeName
            ).put(data);


            tx.oncomplete =
                resolve;


            tx.onerror =
                () =>
                    reject(
                        tx.error
                    );


            tx.onabort =
                () =>
                    reject(
                        tx.error ||
                        new Error(
                            "Transakcia bola prerušená."
                        )
                    );
        }
    );
}


function deleteRecord(
    storeName,
    key
) {

    return new Promise(
        (resolve, reject) => {

            const tx =
                db.transaction(
                    storeName,
                    "readwrite"
                );


            tx.objectStore(
                storeName
            ).delete(key);


            tx.oncomplete =
                resolve;


            tx.onerror =
                () =>
                    reject(
                        tx.error
                    );


            tx.onabort =
                () =>
                    reject(
                        tx.error ||
                        new Error(
                            "Transakcia bola prerušená."
                        )
                    );
        }
    );
}


function deleteByIndex(
    storeName,
    indexName,
    value
) {

    return new Promise(
        (resolve, reject) => {

            const tx =
                db.transaction(
                    storeName,
                    "readwrite"
                );


            const store =
                tx.objectStore(
                    storeName
                );


            const request =
                store
                .index(indexName)
                .openCursor(
                    IDBKeyRange.only(
                        value
                    )
                );


            request.onsuccess =
                event => {

                    const cursor =
                        event.target.result;


                    if (cursor) {

                        cursor.delete();

                        cursor.continue();
                    }
                };


            tx.oncomplete =
                resolve;


            tx.onerror =
                () =>
                    reject(
                        tx.error
                    );


            tx.onabort =
                () =>
                    reject(
                        tx.error ||
                        new Error(
                            "Transakcia bola prerušená."
                        )
                    );
        }
    );
}


/* =========================================================
   FOTO + EMBEDDING – JEDNA TRANSAKCIA
========================================================= */

function putPhotoAndEmbedding(
    photo,
    embedding
) {

    return new Promise(
        (resolve, reject) => {

            const tx =
                db.transaction(
                    [
                        "photos",
                        "embeddings"
                    ],
                    "readwrite"
                );


            tx.objectStore(
                "photos"
            ).put(photo);


            tx.objectStore(
                "embeddings"
            ).put(embedding);


            tx.oncomplete =
                resolve;


            tx.onerror =
                () =>
                    reject(
                        tx.error
                    );


            tx.onabort =
                () =>
                    reject(
                        tx.error ||
                        new Error(
                            "Foto a embedding sa nepodarilo uložiť."
                        )
                    );
        }
    );
}


/* =========================================================
   NOVÝ TYP
========================================================= */

async function addMeterType() {

    const name =
        prompt(
            "Názov typu merača:"
        );


    if (
        !name ||
        !name.trim()
    ) {
        return;
    }


    const meterType = {

        id:
            "meter-" + id(),

        name:
            name.trim(),

        manufacturer:
            "",

        model:
            "",

        created:
            new Date().toISOString(),

        referencePhotoId:
            null,

        ocrRegions: {

            serialNumber:
                null,

            nominalFlow:
                null,

            meterStatus:
                null
        }
    };


    try {

        await put(
            "meterTypes",
            meterType
        );


        setStatus(
            "Typ merača bol vytvorený."
        );


        await refreshUI();


    } catch (error) {

        console.error(error);


        setStatus(
            "Typ merača sa nepodarilo vytvoriť.",
            true
        );
    }
}


/* =========================================================
   ÚPRAVA TYPU
========================================================= */

async function editMeterType(
    meterTypeId
) {

    const type =
        await getById(
            "meterTypes",
            meterTypeId
        );


    if (!type) {
        return;
    }


    const name =
        prompt(
            "Nový názov:",
            type.name
        );


    if (
        name === null ||
        !name.trim()
    ) {
        return;
    }


    type.name =
        name.trim();


    /*
     * ID sa nemení.
     */
    await put(
        "meterTypes",
        type
    );


    setStatus(
        "Názov bol upravený."
    );


    await refreshUI();
}


/* =========================================================
   PRIDANIE FOTOGRAFIÍ
========================================================= */

async function addPhotos(
    meterTypeId
) {

    const input =
        document.createElement(
            "input"
        );


    input.type =
        "file";

    input.accept =
        "image/*";

    input.multiple =
        true;


    input.onchange =
        async () => {

            const files =
                Array.from(
                    input.files || []
                );


            if (
                !files.length
            ) {
                return;
            }


            try {

                /*
                 * Model sa načíta pred
                 * prvou fotografiou.
                 */
                await loadCLIP();


                let processed =
                    0;


                for (
                    const file
                    of files
                ) {

                    setClipProgress(
                        `CLIP: fotografia ${processed + 1}/${files.length}`
                    );


                    const photoId =
                        "photo-" + id();


                    /*
                     * Skutočný CLIP embedding.
                     */
                    const vector =
                        await createCLIPEmbedding(
                            file
                        );


                    const photo = {

                        id:
                            photoId,

                        meterTypeId,

                        blob:
                            file,

                        fileName:
                            file.name,

                        created:
                            new Date().toISOString()
                    };


                    const embedding = {

                        id:
                            "embedding-" + id(),

                        photoId,

                        meterTypeId,

                        vector,

                        created:
                            new Date().toISOString(),

                        model:
                            EMBEDDING_MODEL
                    };


                    /*
                     * FOTO + EMBEDDING
                     * atomicky.
                     */
                    await putPhotoAndEmbedding(
                        photo,
                        embedding
                    );


                    processed++;


                    openPhotoIds.add(
                        meterTypeId
                    );
                }


                /*
                 * Po pridaní všetkých
                 * fotografií prepočítame
                 * prototyp.
                 */
                await rebuildPrototype(
                    meterTypeId
                );


                setStatus(
                    `Pridaných fotografií: ${processed}`
                );


                setClipProgress(
                    `CLIP: hotovo – ${processed} fotografií`
                );


                await refreshUI();


            } catch (error) {

                console.error(
                    error
                );


                setStatus(
                    "CLIP / uloženie fotografie zlyhalo: " +
                    error.message,
                    true
                );
            }
        };


    input.click();
}


/* =========================================================
   PROTOTYP
========================================================= */

async function rebuildPrototype(
    meterTypeId
) {

    const embeddings =
        await getAllByIndex(
            "embeddings",
            "meterTypeId",
            meterTypeId
        );


    if (
        !embeddings.length
    ) {

        await deleteRecord(
            "prototypes",
            meterTypeId
        );

        return;
    }


    const vectors =
        embeddings.map(
            item =>
                item.vector
        );


    const vector =
        averageVectors(
            vectors
        );


    const prototype = {

        meterTypeId,

        vector,

        count:
            embeddings.length,

        updated:
            new Date().toISOString(),

        model:
            EMBEDDING_MODEL
    };


    await put(
        "prototypes",
        prototype
    );
}


/* =========================================================
   DELETE FOTO
========================================================= */

async function deletePhoto(
    photoId,
    meterTypeId
) {

    if (
        !confirm(
            "Naozaj chceš vymazať túto fotografiu?"
        )
    ) {
        return;
    }


    try {

        const embedding =
            await getByIndex(
                "embeddings",
                "photoId",
                photoId
            );


        if (
            embedding
        ) {

            await deleteRecord(
                "embeddings",
                embedding.id
            );
        }


        await deleteRecord(
            "photos",
            photoId
        );


        await rebuildPrototype(
            meterTypeId
        );


        openPhotoIds.add(
            meterTypeId
        );


        setStatus(
            "Fotografia bola vymazaná."
        );


        await refreshUI();


    } catch (error) {

        console.error(error);


        setStatus(
            "Fotografiu sa nepodarilo vymazať.",
            true
        );
    }
}


/* =========================================================
   DELETE TYP
========================================================= */

async function deleteMeterType(
    meterTypeId
) {

    const type =
        await getById(
            "meterTypes",
            meterTypeId
        );


    if (!type) {
        return;
    }


    if (
        !confirm(
            `Naozaj chceš vymazať "${type.name}" a všetky jeho fotografie?`
        )
    ) {
        return;
    }


    try {

        await deleteByIndex(
            "photos",
            "meterTypeId",
            meterTypeId
        );


        await deleteByIndex(
            "embeddings",
            "meterTypeId",
            meterTypeId
        );


        await deleteRecord(
            "prototypes",
            meterTypeId
        );


        await deleteRecord(
            "meterTypes",
            meterTypeId
        );


        openPhotoIds.delete(
            meterTypeId
        );


        setStatus(
            "Typ merača bol vymazaný."
        );


