    for (
        const [
            key,
            url
        ]
        of photoObjectURLs
    ) {

        if (
            key.startsWith(
                meterTypeId + ":"
            )
        ) {

            URL.revokeObjectURL(
                url
            );

            photoObjectURLs.delete(
                key
            );
        }
    }


    const photos =
        await getAllByIndex(
            "photos",
            "meterTypeId",
            meterTypeId
        );


    container.innerHTML =
        "";


    if (
        !photos.length
    ) {

